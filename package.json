{
  "name": "dsh-chatgpt-oauth",
  "version": "0.1.0",
  "description": "ChatGPT account OAuth login and Codex usage display for DeepSeek Harness.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node --test tests/*.test.js"
  },
  "files": [
    "lib/",
    "docs/",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "chatgpt",
    "openai-codex",
    "oauth",
    "usage"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhangnan/dsh-chatgpt-oauth.git"
  },
  "homepage": "https://github.com/zhangnan/dsh-chatgpt-oauth#readme",
  "bugs": {
    "url": "https://github.com/zhangnan/dsh-chatgpt-oauth/issues"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "license": "MIT"
}
